# Required LLM API configuration
LLM_API_KEY=replace_with_your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Required Zep Cloud configuration
ZEP_API_KEY=replace_with_your_zep_api_key

# Security: generate independent random values (at least 32 characters).
# Keep these server-side. NEVER add API_AUTH_TOKEN to frontend VITE_* variables.
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
API_AUTH_TOKEN=replace_with_a_different_random_api_token_at_least_32_chars

# Comma-separated exact browser origins. Empty means same-origin only / no CORS.
CORS_ALLOWED_ORIGINS=

# Local development bypass is opt-in and only accepted for loopback clients.
# Keep false for any shared, LAN-accessible or production deployment.
ALLOW_INSECURE_LOCAL_DEV=false

# Per-client request limits (in-memory; use a shared gateway limiter for multi-worker deployments).
API_RATE_LIMIT_PER_MINUTE=60
API_EXPENSIVE_RATE_LIMIT_PER_MINUTE=5

# Optional accelerated LLM configuration
# LLM_BOOST_API_KEY=
# LLM_BOOST_BASE_URL=
# LLM_BOOST_MODEL_NAME=
